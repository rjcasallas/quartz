class {{-core}}({{-ref}}):

    def __init__(self{{#each columns}}, {{-param}}=None{{/each}}):
        super().__init__({{#-list keys}}{{-param}}{{/-list}})
{{#each nonkeys}}
        self.{{-name}} = {{-param}}
{{/each}}

    def __repr__(self):
        ref = super().__repr__()
{{#each nonkeys}}
        {{-param}} = Parse.string(self.{{-field}})
{{/each}}
        return "{}({{#-list nonkeys}}{{-name}}:{}{{/-list}})".format(ref{{#each nonkeys}},{{-param}}{{/each}})
{{#each nonkeys}}

    @property
    def {{-name}}(self):
        return self.{{-field}}
    @{{-name}}.setter
    def {{-name}}(self, x):
{{#if into}}
        self.{{-field}} = {{-ref into}}.valid(x, True)
{{else}}
        self.{{-field}} = x
{{/if}}
{{/each}}

    def copy(self, x):
        if isinstance(x, {{-core}}):
            super().copy(x)
{{#each nonkeys}}
            self.{{-name}} = x.{{-name}}
{{/each}}
        return self

{{/if}}
    @staticmethod
    def valid(x, nullable = False):
        if nullable and (x is None):
            return None
        if isinstance(x, {{-core}}):
            return x
        Error.invalid("{{-name}}", x)
