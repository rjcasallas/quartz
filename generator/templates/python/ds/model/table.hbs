class {{-pascal}}({{-pascal}}Ref):

    def __init__(self{{#each nonkeys}}, {{-param}}=None{{/each}}{{#each keys}}, {{-param}}=None{{/each}}):
        super().__init__(id)
{{#each nonkeys}}
        self.{{-name}} = {{-param}}
{{/each}}
{{#if lookup}}

    def __str__(self):
        return self.{{-field _lookup}}
{{/if}}

    def __repr__(self):
        ref = super().__repr__()
{{#each nonkeys}}
        {{-param}} = Parse.string(self.{{-field}})
{{/each}}
        return "{}({{#-list nonkeys}}{{-name}}:{}{{/-list}})".format(ref{{#each nonkeys}}, {{-param}}{{/each}})

    def _validRef(self, x):
        if isinstance(x, {{-pascal}}Ref):
            return x
{{#each nonkeys}}

    @property
    def {{-name}}(self):
        return self.{{-field}}
    @{{-name}}.setter
    def {{-name}}(self, x):
{{#if into}}
        self.{{-field}} = {{-ref into}}.valid(x, True)
{{else}}
        self.{{-field}} = x
{{/if}}
{{/each}}

