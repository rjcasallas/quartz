{{#if into}}
        self.{{-field}} = {{-ref into}}.valid(x, True)
{{else}}
        self.{{-field}} = x
{{/if}}
{{/each}}

    def copy(self, x):
        if isinstance(x, {{-core}}):
            super().copy(x)
{{#each nonkeys}}
            self.{{-name}} = x.{{-name}}
{{/each}}
        return self
