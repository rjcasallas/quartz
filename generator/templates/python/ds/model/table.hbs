class {{-core}}({{-ref}}):

    def __init__(self, {{#-list nonkeys keys}}{{-param}}=None{{/-list}}):
        super().__init__({{#-list keys}}{{-param}}{{/-list}})
{{#each nonkeys}}
        self.{{-name}} = {{-param}}
{{/each}}
{{#if lookup}}

    def __str__(self):
        return Parse.string(self.{{-field _lookup}})
{{/if}}

    def __repr__(self):
        ref = super().__repr__()
{{#each nonkeys}}
        {{-param}} = Parse.string(self.{{-field}})
{{/each}}
        return "{}({{#-list nonkeys}}{{-name}}:{}{{/-list}})".format(ref{{#each nonkeys}}, {{-param}}{{/each}})

    def _validRef(self, x):
        if isinstance(x, {{-ref}}):
            return x
{{#each nonkeys}}

    @property
    def {{-name}}(self):
        return self.{{-field}}
    @{{-name}}.setter
    def {{-name}}(self, x):
{{#if into}}
        self.{{-field}} = {{-ref into}}.valid(x, True)
{{else}}
        self.{{-field}} = x
{{/if}}
{{/each}}

