from {{_module}}.base import *
from quartz.error import Error
from quartz.util import Parse

#
# {{#if parent}}Child{{else}}Entity{{/if}}
#

class {{-model}}({{-ref}}):

{{#if is_entity}}
    def __init__(self, {{#-list nonkeys keys}}{{-param}}=None{{/-list}}):
{{else}}
    def __init__(self, {{#-list columns}}{{-param}}=None{{/-list}}):
{{/if}}
        super().__init__({{#-list keys}}{{-param}}{{/-list}})
{{#each nonkeys}}
        self.{{-name}} = {{-param}}
{{/each}}
{{#if lookup}}

    def __str__(self):
        return Parse.string(self.{{-field _lookup}})
{{/if}}

    def __repr__(self):
        ref = super().__repr__()
{{#each nonkeys}}
        {{-param}} = Parse.string(self.{{-field}})
{{/each}}
        return "{}({{#-list nonkeys}}{{-name}}:{}{{/-list}})".format(ref{{#each nonkeys}}, {{-param}}{{/each}})

    def _validateRef(self, x):
        if isinstance(x, int) or isinstance(x, {{-ref}}):
            return int(x)   
{{#each nonkeys}}

    @property
    def {{-name}}(self):
        return self.{{-field}}
    @{{-name}}.setter
    def {{-name}}(self, x):
{{#if into}}
        self.{{-field}} = {{-ref into}}.valid(x, True)
{{else}}
        self.{{-field}} = x
{{/if}}
{{/each}}

    def copy(self, x):
        if isinstance(x, {{-model}}):
            super().copy(x)
{{#each nonkeys}}
            self.{{-name}} = x.{{-name}}
{{/each}}
        return self

    @staticmethod
    def valid(x):
        if isinstance(x, {{-model}}):
            return x
        Error.invalid("{{-model}}", x)
