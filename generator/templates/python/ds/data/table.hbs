class {{-pascal}}Data(Dataset.{{-ppascal}}):

    def __init__(self, db):
        self._table = {{-pascal}}Table("{{name}}", db)

    def add(self, x, debug:bool=False):
{{#if auto}}
        if isinstance(x, {{#if nonkeys}}{{-model}}{{else}}{{-ref}}{{/if}}) and (x.id is None):
            x.id = self._table.insert(x, debug)
            return x
{{/if}}
{{#if unique_links}}
        {{#if auto}}el{{/if}}if self._replace(x, debug):
            return x
{{/if}}
        self._table.insert(x, debug)
        return x

    def remove(self, x, debug:bool=False):
        return self._table.delete(x, debug)
{{#if nonkeys}}

    def push(self, x, field:Fields=None, debug:bool=False):
{{#if unique_links}}
        if self._replace(x, True, debug):
            return x
{{/if}}
        if isinstance(x, {{-model}}) and isinstance(field, Fields):
            match field:
{{#each nonkeys}}
                case Fields.{{-pascal short}}:
                    x = Table.Info("{{-name table}}", [ {{#-list table.keys}}("{{name}}", x.{{name}}){{/-list}}, ("{{name}}", x.{{name}}) ], {{-len table.keys}})
{{/each}}
                case _:
                    x = None
        return self._table.update(x, debug) if (x is not None) else None

    def pull(self, x:{{-model}}, field:Fields=None, debug:bool=False):
        match field:
            case None:
                row = self._table.one(Table.Info("{{name}}", [ {{#-list keys}}("{{name}}", x.{{name}}){{/-list}}{{#each nonkeys}}, ("{{name}}", None){{/each}} ], {{-len keys}}), debug=debug)
                if (isinstance(row, tuple) or isinstance(row, list)) and (len(row) > 0):
{{#each nonkeys}}
                    x.{{name}} = row[{{@index}}]
{{/each}}
{{#each nonkeys}}
            case Fields.{{-pascal short}}:
                row = self._table.one(Table.Info("{{-name table}}", [ {{#-list table.keys}}("{{name}}", x.{{name}}){{/-list}}, ("{{name}}", None) ], {{-len table.keys}}), debug=debug)
                if (isinstance(row, tuple) or isinstance(row, list)) and (len(row) > 0):
                    x.{{name}} = row[0]
{{/each}}
        return x
{{/if}}

    def has(self, x, debug:bool=False) -> bool:
        return self.ref(x, debug) is not None

    def clear(self, debug:bool=False):
        self._table.deleteAll(debug)

    def refb(self, x=None, order:list[str]=None, limit:str=None, debug:bool=False):
        return self.begin(x, 'pk', order, limit, debug)

    def refn(self, cursor) -> Reference:
        return self.next(cursor, self._reference)

    def ref(self, x=None, order:list[str]=None, limit:str=None, debug:bool=False):
        return self.one(x, self._reference, 'pk', order, limit, debug)

    def refs(self, x=None, order:list[str]=None, limit:str=None, debug:bool=False):
        return self.all(x, self._reference, 'pk', order, limit, debug)

    def begin(self, x=None, columns:str='full', order:list[str]=None, limit:str=None, debug:bool=False):
        return self._table.begin(x, columns, order, limit, debug)

    def next(self, cursor, builder=None):
        fn = self._create if (builder is None) else builder
        return self._table.next(cursor, fn)

    def one(self, x=None, builder=None, columns:str='full', order:list[str]=None, limit:str=None, debug:bool=False):
        fn = self._create if (builder is None) else builder
        return self._table.one(x, fn, columns, order, limit, debug)

    def all(self, x=None, builder=None, columns:str='full', order:list[str]=None, limit:str=None, debug:bool=False):
        fn = self._create if (builder is None) else builder
        return self._table.select(x, fn, columns, order, limit, debug)
{{#if unique_links}}

    def _replace(self, x, allow_delete=False, debug:bool=False) -> bool:
{{#each unique_links}}
{{#if into}}
        # {{{this}}}{{#if is_recursive}} (recursive){{/if}}
        if isinstance(x, {{-ref into.table}}):
            if {{#each into.table.keys}}{{#unless @first}} and {{/unless}}x.{{-name}}{{/each}}:
                return self._table.update(x, debug)
            elif allow_delete:
                return self._table.delete(x, debug)
            else:
                Error.invalid(f'"{{into.table}}" replace', x)
{{/if}}
{{/each}}
        return False
{{/if}}

    def _reference(self, x):
        return {{-ref}}({{#each keys}}{{#unless @first}}, {{/unless}}{{-name}}=x[{{@index}}]{{/each}})
{{#if nonkeys}}

    def _create(self, x):
        return {{-model}}({{#each columns}}{{#unless @first}}, {{/unless}}{{-name}}=x[{{@index}}]{{/each}})
{{/if}}


class {{-pascal}}Table(Table):

    def _insert(self, x):
        # {{-name}}
        if isinstance(x, {{#if nonkeys}}{{-model}}{{else}}{{-ref}}{{/if}}):
            return Table.Info("{{-name}}", [ {{#-list columns}}x.{{-name}}{{/-list}} ], {{-len keys}}, tag=({{#if auto}}"insert" if (x.id is None) else "insert_id"{{else}}"replace"{{/if}}))

    def _update(self, x):
        # {{-name}}
        if isinstance(x, {{#if nonkeys}}{{-model}}{{else}}{{-ref}}{{/if}}):
            return Table.Info("{{-name}}", [ {{#-list columns}}x.{{-name}}{{/-list}} ], {{-len keys}}, tag="update")
{{#each unique_links}}
{{#if into}}
        # {{{this}}}{{#if is_recursive}} (recursive){{/if}}
        if isinstance(x, {{#if into.table.nonkeys}}{{-model into.table}}{{else}}{{-ref into.table}}{{/if}}):
            return Table.Info("{{-name into.table}}", [ {{#-list into.table.columns}}x.{{-name}}{{/-list}} ], tag="replace")
{{/if}}
{{/each}}

    def _delete(self, x):
{{#each unique_links}}
        # {{{this}}}{{#if is_recursive}} (recursive){{/if}}
{{#if is_recursive}}
{{#if into}}
        if isinstance(x, {{-pascal into.table}}Ref):
            return Table.Info("{{-name into.table}}", [ {{#-list into.table.columns}}("{{name}}", x.{{-name}}){{/-list}} ])
{{else}}
        if isinstance(x, {{-pascal name}}Ref):
            return Table.Info("{{-name target.table}}", [ ("{{key}}", int(x)) ])
{{/if}}
{{else}}
        if isinstance(x, {{-pascal into.table}}Ref):
            return Table.Info("{{-name into.table}}", [ {{#-list into.table.keys}}("{{name}}", x.{{-name}}){{/-list}} ])
{{/if}}
{{/each}}
        # pk
{{#if nonkeys}}
{{#if is_entity}}
        if isinstance(x, int) or isinstance(x, {{-ref}}):
            return Table.Info("{{name}}", [ int(x) ], tag="pk")
{{else}}
        if isinstance(x, {{-ref}}):
            return Table.Info("{{name}}", [{{#-list _keys}}x.{{-name}}{{/-list}} ], tag="pk")
{{/if}}
{{#if _lookup}}
        # {{_lookup}}
        if isinstance(x, str):
            return Table.Info("{{name}}", [ x ], tag="{{_lookup}}")
{{/if}}
{{else}}
        if isinstance(x, {{-ref}}):
            return Table.Info("{{-name}}", [ {{#-list keys}}x.{{-name}}{{/-list}} ], tag="pk")
{{/if}}

    def _select(self, x=None) -> tuple:
{{#each aggregate_links}}
        # {{{this}}}{{#if is_recursive}} (recursive){{/if}}
        if isinstance(x, {{#if is_recursive}}{{-pascal name}}{{else}}{{-pascal source.table}}{{/if}}Ref):
