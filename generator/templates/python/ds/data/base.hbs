import {{_module}}.model._dataset as _model
import quartz.gen.data as _base
from quartz.error import Error
from quartz.log import Log
from abc import ABC, abstractmethod

#
# Entities
#

class Entity(ABC):

    def __init__(self, x=None):
        self.api = x

    @property
    def api(self):
        if self._ is None: Error.fail("Detached")
        return self._
    @api.setter
    def api(self, x):
        self._ = Engine.valid(x, nullable=True)

    def attach(self, x:Engine):
        self._ = Engine.valid(x)
        return self

    def detach(self):
        self._ = None
        return self

    @staticmethod
    def valid(x, nullable=False, dettached=True):
        if nullable and (x is None):
            return None
        if isinstance(x, Entity):
            if dettached or x.id:
                return x
        Error.invalid("entity", x)


class Submanager:

    def __init__(self, ent:Entity):
        self._ = Entity.valid(ent)

    @property
    def api(self):
        return self._.api

#
# Managers
#

class Manager(_base.EntityManager):

    def __init__(self, x):
        self._ = Engine.valid(x)

    @property
    def api(self):
        return self._

{{#-each entities}}
class {{-pascal}}Manager(Manager):
    pass

