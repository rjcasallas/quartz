            if {{#each into.table.keys}}{{#unless @first}} or {{/unless}}(x.{{-name}} is None){{/each}}:
                return self._table.delete(x, debug)
{{/if}}
{{/each}}
{{#if nonkeys}}
        # Fields
        if isinstance(x, tuple) and isinstance(x[0], {{-core}}) and isinstance(x[1], Fields):
            o, f = x
{{#each nonkeys}}
            if f == Fields.{{-pascal short}}:
                x = Table.Update("{{-name table}}", [ "{{name}}"{{#each table.keys}}, "{{name}}"{{/each}} ], [ o.{{name}}{{#each table.keys}}, o.{{name}}{{/each}} ], {{-len table.keys}})
{{/each}}
{{/if}}
        return self._table.update(x, debug)

{{#if nonkeys}}
    def get(self, x:{{-core}}, field:Fields=None, debug=False):
        if field is None:
            row = self._table.select(Table.Select("{{-name table}}", [ {{#-list nonkeys keys}}"{{name}}"{{/-list}} ], [ {{#-list keys}}x.{{name}}{{/-list}} ], {{-len keys}}), one=True, debug=debug)
{{#each nonkeys}}
            x.{{name}} = row[{{@index}}]
