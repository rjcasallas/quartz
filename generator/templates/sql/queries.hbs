{{name}}:
  select_ref: |
    SELECT {{#-list _keys}}{{table.alias}}.`{{name}}`{{/-list}}
      FROM `{{name}}` {{alias}}

{{#if _nonkeys}}
  select_all: |
    SELECT {{alias}}.*
      FROM `{{name}}` {{alias}}

{{/if}}
  select_ref_by_pk: |
    @{{name}}/select_ref
     WHERE {{#each _keys}}{{table.alias}}.`{{name}}` = ?{{#unless @last}} AND {{/unless}}{{/each}}

{{#if _nonkeys}}
  select_all_by_pk: |
    @{{name}}/select_all
     WHERE {{#each _keys}}{{table.alias}}.`{{name}}` = ?{{#unless @last}} AND {{/unless}}{{/each}}

{{/if}}
{{#each indexed}}
  select_ref_by_{{-name-}}: |
    @{{-name _table}}/select_ref
      WHERE {{table.alias}}.`{{name}}` = ?

{{#if table.nonkeys}}
  select_all_by_{{-name-}}: |
    @{{-name _table}}/select_all
      WHERE {{table.alias}}.`{{name}}` = ?

{{/if}}
{{/each}}
{{#if auto}}
  insert: |
    INSERT INTO `{{name}}`({{#-list _nonauto}}`{{name}}`{{/-list}})
    VALUES ({{#-list _nonauto}}?{{/-list}})

  insert_id: |
    INSERT INTO `{{name}}`({{#-list columns}}`{{name}}`{{/-list}})
    VALUES ({{#-list columns}}?{{/-list}})

{{else}}
  replace: |
    REPLACE INTO `{{name}}`({{#-list columns}}`{{name}}`{{/-list}})
    VALUES ({{#-list columns}}?{{/-list}})

{{/if}}
{{#if nonkeys}}
  update: |
    UPDATE `{{name}}`
       SET {{#-list _nonkeys}}`{{name}}` = ?{{/-list}}
     WHERE {{#-list _keys}}`{{name}}` = ?{{/-list}}

{{/if}}
  delete: |
    DELETE FROM `{{name}}`

  delete_id: |
    DELETE FROM `{{name}}`
     WHERE {{#each _keys}}{{#unless @first}} AND {{/unless}}`{{name}}` = ?{{/each}}

{{#each indexed}}
  delete_{{-name-}}: |
    DELETE FROM `{{table}}`
     WHERE `{{name}}` = ?

{{/each}}

